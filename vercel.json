{
  "version": 2,
  "installCommand": "npm install --prefix server",
  "buildCommand": "echo Using prebuilt client bundle",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
